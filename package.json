{
  "name": "dsh-api-kit",
  "version": "0.1.0",
  "description": "DeepSeek Harness API Kit bundle: local-first API Kit configuration, discovery, and fixed-target read-only API calls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./typert": { "default": "./lib/typert.host.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/typert.host.js",
    "lib/client.js",
    "lib/model.js",
    "lib/normalizers.js",
    "lib/registry-store.js",
    "lib/registry-archive.js",
    "lib/errors.js",
    "lib/config-validation.js",
    "lib/credential-adapter.js",
    "lib/configuration.js",
    "lib/operation-validation.js",
    "lib/session-selection.js",
    "lib/discovery.js",
    "lib/agent-tools.js",
    "lib/executor.js",
    "lib/transport.js",
    "lib/ip.js",
    "lib/ssrf.js",
    "lib/redaction.js",
    "lib/audit-log.js",
    "lib/runtime-context.js",
    "lib/openapi-import.js",
    "lib/openapi-import-transaction.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "api",
    "openapi",
    "api-kit",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1321928757/dsh-api-kit.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "react": { "optional": true }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-manifest.mjs"
  }
}
