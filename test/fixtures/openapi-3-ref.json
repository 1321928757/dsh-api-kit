    "parameters": { "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } },
    "responses": { "UserResponse": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } },
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } }
  },
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "responses": { "200": { "$ref": "#/components/responses/UserResponse" } }
      }
    }
  }
}
